# Telegram bot (dari @BotFather) - wajib buat notifikasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stage 1: berapa persen minimal perubahan harga 24h buat dianggap "volatile"
GAINER_LOSER_THRESHOLD=15

# Stage 3: berapa persen minimal selisih harga antar-chain buat dianggap gap beneran
MIN_GAP_PERCENT=3

# Berapa halaman CoinGecko markets yang di-scan (250 token/halaman)
COINGECKO_PAGES=1

# Jam sebelum token yang sama boleh di-alert lagi (anti-spam)
ALERT_COOLDOWN_HOURS=6

# Jeda antar siklus scan, dalam menit (proses jalan terus di pm2, bukan cron)
SCAN_INTERVAL_MINUTES=15

# Stage 5: modal notional (USD) buat simulasi bridge & hitung profit bersih
TRADE_SIZE_USD=500

# Stage 5: skip alert kalau profit bersih (setelah fee+gas bridge) di bawah ini (%)
MIN_NET_PROFIT_PERCENT=0
